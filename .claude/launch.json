        "run",
        "ui",
        "--",
        "--port",
        "4748",
        "--no-notify"
      ],
      "port": 4748
    },
    {
      "name": "agentgraph-ui-digest",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ui",
        "--",
        "--port",
        "4749",
        "--no-notify"
      ],
      "port": 4749
    },
    {
      "name": "agentgraph-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ui",
        "--",
        "--port",
        "4750",
        "--no-notify"
      ],
      "port": 4750
    },
    {
      "name": "agentgraph-web-dev",
      "runtimeExecutable": "env",
