{
  "name": "agentgraph",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Generator and runner for agent flows: task -> flow.yaml -> a chain of Claude sessions looping until the acceptance condition passes",
  "main": "dist/desktop/main.js",
  "bin": {
    "agentgraph": "./bin/agentgraph.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p web/tsconfig.node.json",
    "agentgraph": "tsx src/cli.ts",
    "ui": "tsx scripts/ensure-web.mts && tsx src/cli.ts ui",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "desktop:dev": "tsx scripts/ensure-web.mts && npm run build && electron .",
    "desktop:build": "npm run build:web && npm run build && tsx scripts/pty-helper.mts && electron-builder --mac",
    "test": "tsx --test src/*.test.ts web/src/lib/*.test.ts web/src/lib/*/*.test.ts",
    "share": "bash scripts/share.sh",
    "release": "tsx scripts/release.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
